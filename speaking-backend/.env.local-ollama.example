# Local-only Speaking examiner. Copy this file to .env.
EXAMINER_API_KEY=ollama
EXAMINER_BASE_URL=http://localhost:11434/v1
EXAMINER_MODEL=ielts-fighter

# Whisper transcription stays local and downloads its model on first use.
WHISPER_MODEL=base.en
WHISPER_DEVICE=auto
WHISPER_COMPUTE=int8

HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGIN=*
