# Copy to .env and fill in.
# The backend uses any OpenAI-compatible chat completions API for the examiner.
# Examples:
#   Groq            EXAMINER_BASE_URL=https://api.groq.com/openai/v1
#                   EXAMINER_MODEL=llama-3.3-70b-versatile
#   OpenAI          EXAMINER_BASE_URL=https://api.openai.com/v1
#                   EXAMINER_MODEL=gpt-4o-mini
#   Together.ai     EXAMINER_BASE_URL=https://api.together.xyz/v1
#   Anyscale        EXAMINER_BASE_URL=https://api.endpoints.anyscale.com/v1
#   Local Ollama    EXAMINER_BASE_URL=http://localhost:11434/v1
#                   EXAMINER_MODEL=ielts-fighter
#                   EXAMINER_API_KEY=ollama   (Ollama ignores it but the field is required)
#                   Or copy .env.local-ollama.example to .env.

EXAMINER_API_KEY=
EXAMINER_BASE_URL=https://api.groq.com/openai/v1
EXAMINER_MODEL=llama-3.3-70b-versatile

# Whisper config
WHISPER_MODEL=base.en          # tiny.en | base.en | small.en | medium.en | large-v3 (CPU: base.en is a sane default)
WHISPER_DEVICE=auto            # auto | cpu | cuda. "auto" prefers a GPU; if its CUDA libs
                               #   (cublas/cudnn DLLs) are missing the code now auto-falls back
                               #   to CPU, but set WHISPER_DEVICE=cpu to skip the GPU attempt entirely.
WHISPER_COMPUTE=int8           # int8 (CPU) | float16 (GPU)

# Server
HOST=127.0.0.1
PORT=8000
# CORS — accept any origin by default so file:// (double-click index.html) works.
# Override with a comma list if you want to restrict, e.g.:
#   ALLOWED_ORIGIN=http://localhost:5173,http://localhost:3000
ALLOWED_ORIGIN=*
